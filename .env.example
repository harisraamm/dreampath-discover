# Copy this file to .env and replace placeholders. Never commit .env.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
JWT_SECRET=replace-with-at-least-32-random-characters

# Email OTP through your SMTP provider (Gmail requires an App Password).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-smtp-or-app-password
MAIL_FROM=your-email@example.com

# SMS OTP through Twilio. Leave blank until a Twilio account/number is configured.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
